# Copy this file to `.env.local` for local development if needed.
# Contact form posts to `/api/contact` (Worker / local admin API), which emails
# `site.email` via FormSubmit by default (no captcha redirect). First-time
# FormSubmit activation may send a one-time Activate link to that inbox.
# Optional more reliable provider:
# RESEND_API_KEY=
# RESEND_FROM=Adwise Media <onboarding@resend.dev>

# Admin login lives in data/admin-auth.json (PBKDF2 hash — never commit plaintext).
# First-time setup:
#   npm run bootstrap:admin
# That prints a strong default password and writes .data/admin-default-password.txt
# Optional: seed with your own password (min 12 chars, mixed case, number, symbol):
# ADMIN_PASSWORD=

# Recommended: publish CMS saves to GitHub (Cloudflare rebuilds automatically).
# Local dev auto-uses `gh auth token` when GITHUB_TOKEN is unset.
GITHUB_TOKEN=
GITHUB_REPO=shimshonwq/adwise-portfolio
GITHUB_BRANCH=main

# Production (Cloudflare Worker secrets):
#   npx wrangler secret put GITHUB_TOKEN
#   npx wrangler secret put GITHUB_REPO
#   npx wrangler secret put GITHUB_BRANCH   # optional, defaults to main
#   npx wrangler secret put RESEND_API_KEY  # optional, preferred email delivery
# Push data/admin-auth.json to GitHub (npm run bootstrap:admin) before going live.
