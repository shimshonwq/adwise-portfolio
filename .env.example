# Copy this file to `.env.local` for local development if needed.
# Contact form submissions go to adwisecreativity@gmail.com via FormSubmit
# (no env var required). The first form submission triggers a one-time
# confirmation email — open that email and click Confirm to activate.

# Private admin at /login (not linked from the public site).
ADMIN_PASSWORD=adwise-admin

# Recommended: publish CMS saves to GitHub (Cloudflare rebuilds automatically).
# Create a token at https://github.com/settings/tokens with "Contents" write on this repo.
GITHUB_TOKEN=
GITHUB_REPO=shimshonwq/adwise-portfolio
GITHUB_BRANCH=main

# Production (Cloudflare Worker secrets — same names):
#   npx wrangler secret put ADMIN_PASSWORD
#   npx wrangler secret put GITHUB_TOKEN
#   npx wrangler secret put GITHUB_REPO
#   npx wrangler secret put GITHUB_BRANCH   # optional, defaults to main
