{
  // Cloudflare Workers (static assets) + CMS API on /api/*
  "name": "adwise-portfolio",
  "account_id": "77773650553f3b5b25a723e62a86afee",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-15",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/data/content.json", "/uploads/*"]
  }
  // Secrets (recommended — durable classic PAT, repo scope, no expiration):
  //   ADWISE_GITHUB_TOKEN=ghp_… npm run secrets:worker
  // Admin password hash: data/admin-auth.json in GitHub only (npm run bootstrap:admin)
  //
  // Optional legacy fallback (instant saves without git):
  //   kv_namespaces: [{ "binding": "LOGOS", "id": "...", "preview_id": "..." }]
}
